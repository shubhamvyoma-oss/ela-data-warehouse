DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Optional: used by migration and backup commands, not by the webhook runtime.
DATABASE_URL=

WEBHOOK_SCHEMA_NAME=public
WEBHOOK_TABLE_NAME=webhook_events
WEBHOOK_DEDUP_ENABLED=false
WEBHOOK_SHARED_SECRET=
WEBHOOK_HMAC_SECRET=
WEBHOOK_AUTH_MODE=disabled
WEBHOOK_TOTAL_FAILURE_STATUS=503
ADMIN_TOKEN=

DATA_DIRECTORY=/app/data
LOG_DIRECTORY=/app/logs
MAX_PAYLOAD_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
QUEUE_CLAIM_TIMEOUT_SECONDS=300
REPLAY_BATCH_SIZE=100
REPLAY_MAX_ATTEMPTS=10
DISK_MIN_FREE_MB=100

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
