# Warehouse database (use a separate database; never point this at webhook_db)
WAREHOUSE_DB_HOST=host.docker.internal
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=ela_warehouse
WAREHOUSE_DB_USER=ela_app
WAREHOUSE_DB_PASSWORD=replace_me
WAREHOUSE_DB_SSLMODE=prefer
WAREHOUSE_DB_CONNECT_TIMEOUT_SECONDS=5
WAREHOUSE_DB_STATEMENT_TIMEOUT_MS=30000
WAREHOUSE_DB_POOL_MIN_CONNECTIONS=1
WAREHOUSE_DB_POOL_MAX_CONNECTIONS=4

# Runtime
WAREHOUSE_ENVIRONMENT=development
WAREHOUSE_LOG_LEVEL=INFO
WAREHOUSE_DATA_DIRECTORY=/app/data
WAREHOUSE_LOG_DIRECTORY=/app/logs
WAREHOUSE_MIN_FREE_DISK_MB=20480
WAREHOUSE_SCHEDULER_CONFIG=/app/services/scheduler/jobs.example.yaml

# Edmingle API (secrets stay in .env or a secret manager)
EDMINGLE_API_BASE_URL=https://vyoma-api.edmingle.com/nuSource/api/v1
EDMINGLE_API_KEY=
EDMINGLE_API_KEY_EXPIRES_AT=
EDMINGLE_API_KEY_STOP_DAYS_BEFORE_EXPIRY=3
EDMINGLE_ORGANIZATION_ID=
EDMINGLE_INSTITUTE_ID=
EDMINGLE_REQUEST_TIMEOUT_SECONDS=60
EDMINGLE_MAX_RETRIES=4
EDMINGLE_MIN_REQUEST_INTERVAL_SECONDS=2.5
EDMINGLE_BATCHES_PER_PAGE=100
EDMINGLE_STUDENTS_PER_PAGE=100
EDMINGLE_INITIAL_RETRY_DELAY_SECONDS=5
EDMINGLE_MAXIMUM_RETRY_DELAY_SECONDS=300

# Collection windows. Empty values use the job's safe checkpoint/default behavior.
ATTENDANCE_START_DATE=
ATTENDANCE_END_DATE=
ATTENDANCE_LOOKBACK_DAYS=1

# Scheduler starts disabled until API configuration and storage preflight pass.
WAREHOUSE_SCHEDULER_ENABLED=false

# class_session_attendance job (required, no default lookback)
CLASS_SESSION_ATTENDANCE_START_DATE=
CLASS_SESSION_ATTENDANCE_END_DATE=

# attendance job -- report55 batch/session summary transform options
ATTENDANCE_ACTIVE_STATUS_VALUES=Active
ATTENDANCE_SESSION_ID_COLUMN=attendance_id
ATTENDANCE_PRESENT_VALUE=P
ATTENDANCE_ABSENT_VALUE=A
ATTENDANCE_LATE_VALUE=L
ATTENDANCE_TREAT_ZERO_RATING_AS_MISSING=true

# students job
STUDENTS_PER_PAGE=500

# enrollment_reports job (required start/end, DD-MM-YYYY)
ENROLLMENT_REPORTS_START_DATE=
ENROLLMENT_REPORTS_END_DATE=
ENROLLMENT_REPORTS_CHUNK_DAYS=30
ENROLLMENT_REPORTS_PER_PAGE=100

# api_key_manager/generate.py -- automated Edmingle API key generation + email delivery
EDMINGLE_LOGIN_URL=https://vyoma-api.edmingle.com/nuSource/api/v1/tutor/login
EDMINGLE_TUTOR_USERNAME=
EDMINGLE_TUTOR_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_APP_PASSWORD=
SMTP_TO_EMAILS=
